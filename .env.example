# Copie para .env.local (no seu computador) ou cadastre na Vercel em Settings → Environment Variables.

# Senha do painel /admin (obrigatória em produção). Use uma senha longa.
ADMIN_PASSWORD=

# Opcional: chave usada para assinar o login do painel. Se vazia, usa a própria senha.
# Trocar este valor desconecta todo mundo do painel.
ADMIN_SESSION_SECRET=

# Banco de dados Supabase (Project Settings → API). Sem estas duas, a loja roda em modo demonstração.
SUPABASE_URL=
# Chave secreta "service_role": NUNCA coloque em código que vai para o navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: endereço público, quando tiver domínio próprio (ex.: https://www.newfitness.com.br)
NEXT_PUBLIC_SITE_URL=
